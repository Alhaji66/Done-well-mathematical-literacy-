# Copy this file to .env and fill in your own Supabase project's values.
# Find these under Project Settings -> API in the Supabase dashboard.
# The publishable/anon key is safe to expose in the browser (Row Level
# Security policies protect the data) -- never put the service_role/secret
# key here or anywhere in this repo.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The Supabase region this project is hosted in, e.g. af-south-1 or eu-west-1.
# Shown under Project Settings -> General in the Supabase dashboard.
#
# The POPIA notice names it, because POPIA s72 makes storing personal
# information outside South Africa a cross-border transfer that the notice has
# to declare. Nothing reachable from the browser reveals the region (the API
# domain is behind a CDN), so it has to be configured here. Left unset, the
# notice states the s72 basis without naming the region.
VITE_SUPABASE_REGION=af-south-1
